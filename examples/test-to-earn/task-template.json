{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test-to-Earn Task Template",
  "description": "A task published by a project for agents to execute.",
  "type": "object",
  "required": ["taskId", "title", "network", "steps", "reward", "createdBy"],
  "properties": {
    "taskId": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "network": { "type": "string", "description": "Target blockchain network, e.g. 'base-sepolia'" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string" },
          "params": { "type": "object" }
        }
      }
    },
    "reward": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["points", "tokens", "nft", "unknown"] },
        "amount": { "type": "number" }
      }
    },
    "createdBy": { "type": "string", "description": "Parent AUP DID" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
