{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yokaicpunk/agent-universal-passport/schemas/skill-attestation.json",
  "title": "Skill Attestation",
  "description": "A standardized skill document submitted by a child agent and manually attested by the parent.",
  "type": "object",
  "required": ["id", "name", "type", "body", "attestation"],
  "properties": {
    "id": { "type": "string", "description": "Unique skill identifier, e.g. 'skill-mj-portrait-v2'" },
    "version": { "type": "string", "description": "Semantic version, e.g. '1.0.0'" },
    "name": { "type": "string", "description": "Human-readable name" },
    "type": { "type": "string", "enum": ["prompt-template", "tool-config", "pipeline", "knowledge", "other"] },
    "description": { "type": "string" },
    "author": { "type": "string", "description": "Child agent ID that created this skill" },
    "body": {
      "type": "object",
      "description": "The actual skill content. Schema varies by type.",
      "properties": {
        "template": { "type": "string" },
        "parameters": { "type": "object" },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "attestation": {
      "type": "object",
      "description": "Attestation metadata. Populated when parent approves.",
      "properties": {
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "attestedAt": { "type": "string", "format": "date-time" },
        "parentSignature": { "type": "string" },
        "testResults": {
          "type": "object",
          "properties": {
            "successRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "totalRuns": { "type": "integer" }
          }
        }
      }
    }
  }
}
