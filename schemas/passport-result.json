{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Passport Result",
  "description": "Schema for the Agent Passport evaluation result (result.json), compatible with AUP protocol metadata binding.",
  "type": "object",
  "required": ["passport", "results", "summary", "aup_metadata"],
  "properties": {
    "passport": {
      "type": "object",
      "description": "Evaluation metadata",
      "required": ["version", "agent_id", "evaluated_at"],
      "properties": {
        "version": {
          "type": "string",
          "description": "Evaluator version (semver)"
        },
        "agent_id": {
          "type": ["string", "null"],
          "description": "Optional ERC-8004 identity ID or AUP DID"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp of evaluation"
        }
      }
    },
    "results": {
      "type": "array",
      "description": "Individual task results",
      "items": {
        "type": "object",
        "required": ["task", "score", "max_score", "passed", "details", "raw_output"],
        "properties": {
          "task": {
            "type": "string",
            "description": "Task name (e.g. 'security', 'reasoning')"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "description": "Raw score achieved"
          },
          "max_score": {
            "type": "number",
            "minimum": 0,
            "description": "Maximum possible score"
          },
          "passed": {
            "type": "boolean",
            "description": "Whether this task met the pass threshold"
          },
          "details": {
            "type": "object",
            "description": "Task-specific detail data"
          },
          "raw_output": {
            "type": "string",
            "description": "Human-readable summary of the task result"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Aggregated evaluation summary",
      "required": ["overall_score", "tasks_passed", "tasks_total", "overall_passed"],
      "properties": {
        "overall_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Weighted average score across all tasks"
        },
        "tasks_passed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tasks that passed"
        },
        "tasks_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of tasks run"
        },
        "overall_passed": {
          "type": "boolean",
          "description": "Whether overall evaluation passed (overall_score >= 0.5)"
        }
      }
    },
    "aup_metadata": {
      "type": "object",
      "description": "AUP protocol integration fields — populated when the passport is bound to an AUP identity or skill",
      "properties": {
        "aup_did": {
          "type": ["string", "null"],
          "description": "AUP Decentralized Identifier (e.g. 'did:aup:0x...')"
        },
        "skill_attestation_hash": {
          "type": ["string", "null"],
          "description": "IPFS CID or keccak256 hash of the matching skill attestation"
        },
        "parent_signature": {
          "type": ["string", "null"],
          "description": "EIP-712 signature from the parent agent owner, verifying this passport"
        },
        "child_certificate": {
          "type": ["string", "null"],
          "description": "AUP child certificate token ID if this passport was generated by a child agent"
        }
      }
    }
  }
}
